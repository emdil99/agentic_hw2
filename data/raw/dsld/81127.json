{"src":"01-raw/2025-09-25/data/label_453.json","id":81127,"nhanesId":"","bundleName":"","fullName":"Whey Protein Unflavored","brandName":"Bulletproof","brandIpSymbol":"™","upcSku":"","productVersionCode":"R02 170525","pdf":"","thumbnail":"","servingsPerContainer":"19","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":9761,"text":"Manufactured in USA for:","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_3.json","id":9761,"name":"Bulletproof 360, INC.","streetAddress":"","city":"Bellevue","state":"WA","country":"","zipCode":"98004","phoneNumber":"1-425-434-9704","email":"","webAddress":"bulletproof.com"}}],"netContents":[{"order":1,"quantity":16,"unit":"Oz(s)","display":"16 Oz(s)"},{"order":2,"quantity":1,"unit":"lb","display":"1 lb"},{"order":3,"quantity":454,"unit":"Gram(s)","display":"454 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":24,"maxQuantity":24,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"2 scoops","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"General Statements: All Other Content","notes":"Why This Whey Is Better\nMake your protein count."},{"type":"Formula re: Contains","notes":"This virgin whey protein is made with milk from pasture-raised cows and has pasture-raised colostrum added to give you more IgG proteins than regular whey. It was minimally processed at low temperatures to keep those valuable proteins intact, and it's mixed with Bulletproof XCT oil for added energy."},{"type":"General Statements: All Other Content","notes":"That's nutrition nerd talk for: This whey gives you more bang. A lot more bang."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Serve It Cold\nDon't heat it!"},{"type":"Precautions re: All Other","notes":"Don't heat it!"},{"type":"General Statements: All Other Content","notes":"The good stuff in Bulletproof Whey Protein starts to break down at warmer temperatures. You work too hard for that."},{"type":"Suggested/Recommended/Usage/Directions","notes":"If you're looking for a protein that can take the heat, try Bulletproof Collagen Protein or Collagelatin."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: Mix 2 scoops in 4-8 ounces of unheated water or whatever you'd like. Bulletproof Whey Protein is flavorless and odorless so it mixes well with just about everything."},{"type":"General Statements: All Other Content","notes":"The Bulletproof You\nWhat else are you capable of? More than you might think. Being Bulletproof is a science-based approach to nutrition and life - tried, tested and proven to help improve human performance in athletes, mathletes and anyone who wants to be more awesome.\nSee what you can do at bulletproof.com"},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Formula re: Contains","notes":"Contains: Milk."},{"type":"Precautions re: Allergies","notes":"Contains: Milk.\nProcessed in a facility that also processes tree nuts, peanuts, egg, soy, milk, wheat, fish, crustacean shellfish."},{"type":"General Statements: All Other Content","notes":"Typical Amino Acid Profile\n(Per 24g serving)\nAlanine 745mg\nArginine 483mg\nAspartic acid 1,602mg\nGlutamic acid 345mg\nGlycine 2,591mg\nHistidine** 316mg\nHydroxyproline 273mg\nIsoleucine** 928mg\nLeucine** 1,578mg\nLysine 1,352mg\nMethionine** 334mg\nPhenylalanine 525mg\nProline 997mg\nSerine 843mg\nThreonine** 1,048mg\nTryptophan** 312mg\nTyrosine 544mg\nValine 899mg\n*Amino acid profile may vary\n**Essential amino acids"},{"type":"General Statements: All Other Content","notes":"Note: Product is packaged with a desiccant."},{"type":"Storage","notes":"Store in a cool, dark, dry place. No refrigeration required."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"2017 Bulletproof 360, Inc.\nAll rights reserved."},{"type":"General: Product/Version Code","notes":"R02 170525"},{"type":"General Statements: All Other Content","notes":"Build \nPasture raised"},{"type":"Formula re: Contains","notes":"With colostrum from pasture raised cows + Bulletproof XCT Oil"},{"type":"Formulation re: Vegetarian/Vegan","notes":"Vegetarian protein/sustained energy"},{"type":"General Statements: All Other Content","notes":"Vegetarian protein/sustained energy"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2017-12-22","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":100,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":2,"ingredientId":18184,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":2,"unit":"Gram(s)","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":11,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Saturated Fat","category":"fat","ingredientGroup":"Saturated fat","uniiCode":null,"alternateNames":[],