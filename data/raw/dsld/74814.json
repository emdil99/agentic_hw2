{"src":"01-raw/2025-03-25/data/label_21.json","id":74814,"nhanesId":"","bundleName":"","fullName":"Amplified Creatine 189","brandName":"GNC Pro Performance AMP","brandIpSymbol":"®","upcSku":"0 48107 09295 5","productVersionCode":"CODE 825811 CRG","pdf":"","thumbnail":"","servingsPerContainer":"60","hasOuterCarton":false,"percentDvFootnote":"Not Present","labelRelationships":[{"type":"Image difference, same product","labelId":69333},{"type":"Image difference, same product","labelId":4844},{"type":"Package size difference, same product","labelId":4845},{"type":"Package size difference, same product","labelId":74811}],"contacts":[{"contactId":1167,"text":"Distributed by:","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_1.json","id":1167,"name":"General Nutrition Corporation","streetAddress":"","city":"Pittsburgh","state":"PA","country":"","zipCode":"15222","phoneNumber":"1-888-462-2548","email":"","webAddress":"gnc.com"}}],"netContents":[{"order":1,"quantity":120,"unit":"Tablet(s)","display":"120 Tablet(s)"}],"physicalState":{"langualCode":"E0155","langualCodeDescription":"Tablet or Pill"},"servingSizes":[{"order":1,"minQuantity":2,"maxQuantity":2,"minDailyServings":1,"maxDailyServings":1,"unit":"Tablet(s)","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)"],"productType":{"langualCode":"A1309","langualCodeDescription":"Non-Nutrient/Non-Botanical"},"statements":[{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"In a randomized, double-blind clinical study of 57 healthy young adult males, subjects who took GNC Pro Performance AMP Amplified Creatine 189 containing only 1.25 grams creatine significantly improved leg press 1-RM performance by 54 lbs, while subjects on 5 grams of creatine monohydrate improved by 52 lbs, and the placebo group demonstrated no significant improvement.\n"},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"In a clinical study of 17 healthy young adults, muscle biopsy results revealed that GNC Pro Performance AMP Amplified Creatine 189 resulted in 189% greater muscle creatine uptake relative to benchmark amounts of ordinary creatine monohydrate powder."},{"type":"General Statements: All Other Content","notes":"189% improved muscle creatine absorption"},{"type":"Formula re: Contains","notes":"The power of 5g of creatine in 2 tablets"},{"type":"General Statements: All Other Content","notes":"400% increase in dose efficiency to enhance athletic performance"},{"type":"General Statements: All Other Content","notes":"Clinically researched"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General: Product/Version Code","notes":"Code 825811 CRG"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: As a dietary supplement, take two tablets daily."},{"type":"General Statements: All Other Content","notes":"Studies have shown that taking creatine is beneficial before, during or after exercise."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Take Amplified Creatine 189 daily at a time convenient for you. Consume ample amounts of water while taking this product."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: Consult your physician prior to using this product if you are pregnant, nursing, taking medication, under 18 years of age or have a medical condition."},{"type":"Precautions re: Children","notes":"Warning: Consult your physician prior to using this product if you are pregnant, nursing, taking medication, under 18 years of age or have a medical condition."},{"type":"Precautions re: All Other","notes":"Discontinue use two weeks prior to surgery."},{"type":"General Statements: All Other Content","notes":"Conforms to USP <2091> for weight."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."},{"type":"Storage","notes":"Store in a cool, dry place."},{"type":"General Statements: All Other Content","notes":"Product was tested for over 145 b