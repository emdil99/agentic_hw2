{"src":"01-raw/2025-09-25/data/label_299.json","id":242861,"nhanesId":"","bundleName":"","fullName":"Natural Whey Protein Vanilla","brandName":"MET-Rx","brandIpSymbol":"®","upcSku":"7 86560 17772 6","productVersionCode":"ACNU10934 17772 08F B100106 Part No. 30-43005","pdf":"","thumbnail":"","servingsPerContainer":"58","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[{"type":"Flavor difference","labelId":66275},{"type":"Package size difference, same product","labelId":63877},{"type":"Package size difference, same product","labelId":33472},{"type":"Flavor difference","labelId":66273},{"type":"Flavor difference","labelId":64349},{"type":"Flavor difference","labelId":242847},{"type":"Package size difference, same product","labelId":66273},{"type":"Image difference, same product","labelId":64067},{"type":"Image difference, same product","labelId":33487},{"type":"Flavor difference","labelId":33487},{"type":"Flavor difference","labelId":33489},{"type":"Flavor difference","labelId":64067},{"type":"Package size difference, same product","labelId":66272},{"type":"Package size difference, same product","labelId":33487},{"type":"Package size difference, same product","labelId":64067},{"type":"Image difference, same product","labelId":66273}],"contacts":[{"contactId":15611,"text":"Manufactured in the USA with Select ingredients from around the world for","types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_3.json","id":15611,"name":"MET-Rx Nutrition, Inc.","streetAddress":"","city":"Boca Raton","state":"FL","country":"","zipCode":"33487","phoneNumber":"1-800-556-3279","email":"","webAddress":"www.METRx.com"}}],"netContents":[{"order":1,"quantity":5,"unit":"Pound(s)","display":"5 Pound(s)"},{"order":2,"quantity":80,"unit":"Ounce(s)","display":"80 Ounce(s)"},{"order":3,"quantity":2.26,"unit":"kg","display":"2.26 kg"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":39,"maxQuantity":39,"minDailyServings":1,"maxDailyServings":4,"unit":"Gram(s)","notes":"1 scoop","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Gluten Free"],"productType":{"langualCode":"A1315","langualCodeDescription":"Multi-Vitamin and Mineral (MVM)"},"statements":[{"type":"General Statements: All Other Content","notes":"When compared to our original formula"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Pre & Post workout\nFor best results and maximum muscle support, take one (1) scoop one to two times daily, especially after exercise."},{"type":"Formula re: Contains","notes":"MET-Rx Natural Whey Protein\nMET-Rx Natural Whey Protein utilizes state-of-the-art manufacturing techniques to deliver a cutting edge ultra-filtered 100% whey protein blend that is both wholesome and scientifically advanced."},{"type":"Formulation re: Does NOT Contain","notes":"Non-GMO and with absolutely no artificial sweeteners, flavors or colors - MET-Rx Natural Whey Protein should be your first choice for high quality protein."},{"type":"Formulation re: Other","notes":"What makes MET-Rx Natural Whey Protein worth it:\nMET-Rx Natural Whey Protein provides gold standard Whey Protein, which undergoes filtration processes to reduce total lactose and carbohydrates while concentrating the natural proteins."},{"type":"Formula re: Contains","notes":"Naturally contains active Whey Protein Peptides and Microfractions including: Beta-lactoglobulin, Alpha-Lactalbumin, Glycomacropeptides, Lactoferrin, and other bio-active components."},{"type":"Formulation re: Other","notes":"Instantized Whey Proteins for easy mixing and complete dispersion in liquid.\nQuick absorbing Whey Protein Blend to speed amino acid delivery to muscles immediately after workouts, to help stimulate muscle protein synthesis."},{"type":"Formula re: Contains","notes":"Contains naturally occurring Branched Chain Amino Acids."},{"type":"Formula re: Contains","notes":"Whey is the preferred protein source in sports and bodybuilding nutrition because it provides a superior source of Branched Chain Amino Acids – made up of Leucine, Isoleucine and Valine – which are important for the maintenance of muscle tissue. Unlike some other incomplete protein sources, MET-Rx Natural Whey Protein contains all of the essential amino acids required for supporting lean muscle."},{"type":"Suggested/Recommended/Usage/Directions","notes":"To support muscle-building, consume approximately 1 gram of protein per pound of body weight from all dietary sources per day."},{"type":"Formulation re: Does NOT Contain","notes":"MET-Rx Natural Whey Protein contains no aspartame."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Blender - Simple \nAdd one scoop of MET-Rx Natural Whey Protein to blender filled with 6-8 ounces of your favorite beverage. Cover and blend for 20-30 seconds. For a delicious smoothie, add peanut butter, fruit, or yogurt along with ice cubes.\nShaker - Simpler\nFill a shaker bottle with 6-8 ounces of your favorite beverage. Add one scoop of MET-Rx Natural Whey Protein. Cover and shake for 25-30 seconds.\nGlass & Spoon - Simplest\nAdd one scoop of MET-Rx Natural Whey Protein to 6-8 ounces of your favorite beverage. Stir for 20-30 seconds or until completely blended.\nFor Mass Gaining: add higher calorie foods such as peanut butter, 1-2% milk, and fruit juices.\nFor Dieters: add lower calorie foods such as skim milk, blueberries and raspberries, or just use water.\nUse in conjunction with an intense daily exercise program and a balanced diet including an adequate caloric intake."},{"type":"General Statements: All Other Content","notes":"New and Improved taste"},{"type":"Formulation re: Does NOT Contain","notes":"No artificial flavors, colors or sweeteners\nGluten free\nNon-GMO"},{"type":"Formulation re: Other","notes":"Supports lean muscle and strength\nUltra-Filtered"},{"type":"Formula re: Contains","notes":"25g protein\n12 vitamins & minerals\nMore Protein\nProtein Powder"},{"type":"FDA Statement of Identity","notes":"Protein Powder Dietary Supplement"},{"type":"Precautions re: All Other","notes":"Notice: Use this product as a food supplement only. Do not use for weight reduction."},{"type":"Formula re: Contains","notes":"Contains milk ingredients."},{"type":"Precautions re: Allergies","notes":"Contains milk ingredients.\nMade in a facility that also processes peanuts, tree nuts, egg, wheat, soybean, and sesame."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: Take one (1) scoop (39 g), one to two times daily. Serious athletes should consume 1 scoop 2-4 times per day for maximum muscle support, with at least 1 scoop taken immediately after exercise. As a reminder, discuss the supplements and medications you take with your health care providers."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: If you are pregnant, nursing, taking any medications or have any medical condition, consult your doctor before use."},{"type":"Precautions re: All Other","notes":"Discontinue use and consult your doctor if any adverse reactions occur."},{"type":"Precautions re: Children","notes":"Not intended for use by persons under the age of 18.\nKeep out of reach of children."},{"type":"Storage","notes":"Store at room temperature and avoid excessive heat."},{"type":"Precautions re: All Other","notes":"Tamper Resistant: Do not use product if seal under cap is broken."},{"type":"General Statements: All Other Content","notes":"Contents are sold by weight. Some settling may occur."},{"type":"General Statements: All Other Content","notes":"See nutrition information for cholesterol content."},{"type":"General Statements: All Other Content","notes":"Typical Amino Acid Profile (milligrams per 39 g scoop)\nEssential Amino Acids\nHistidine 549 mg\nIsoleucine 1,482 mg\nLeucine 2,672 mg\nLysine 2,266 mg\nMethionine 544 mg\nPhenylalanine 818 mg\nThreonine 1,947 mg\nTryptophan 417 mg\nValine 1,408 mg\nNonessential Amino Acids\nAlanine 1,118 mg\nArginine 722 mg\nAspartic Acid 2,833 mg\nCysteine 528 mg\nGlutamic Acid 3,590 mg\nGlycine 462 mg\nProline 1,450 mg\nSerine 1,433 mg\nTyrosine 751 mg\nL-Tryptophan is naturally occurring, not added.\napproximate values"},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Copyight 2019"},{"type":"General Statements: All Other Content","notes":"Questions? Call toll free 1-800-55-MET-Rx To learn more, please go to www.metrx.com"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2021-02-25","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":39,"operator":"=","quantity":150,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":2,"ingredientId":4822,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":39,"operator":"=","quantity":2,"unit":"Gram(s)","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":3,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":3,"ingredientId":18183,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuanti