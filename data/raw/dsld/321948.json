 support\r\nSupport muscle function & recovery"},{"type":"Formula re: Contains","notes":"Per serving:\r\n18 g Protein\r\n3.8 g BCAAs\r\nGlutamine"},{"type":"Formulation re: Does NOT Contain","notes":"Non-GMO\r\nGluten free"},{"type":"Precautions re: All Other","notes":"Notice: Use this product as a food supplement only. Do not use for weight reduction."},{"type":"Precautions re: Allergies","notes":"Contains: Milk"},{"type":"Formulation re: Does NOT Contain","notes":"No artificial flavors or sweeteners."},{"type":"Precautions re: All Other","notes":"This product is not a complete nutrient source."},{"type":"Precautions re: All Other","notes":"Do not use if safety seal is damaged of missing."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Copyright 2022 Jarrow Formulas"},{"type":"Storage","notes":"Packaged by weight, not by volume."}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2024-10-24","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":15821,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":26,"operator":"=","quantity":100,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories","category":"other","ingredientGroup":"Header","uniiCode":null,"alternateNames":[],"forms":[]},{"order":2,"ingredientId":18758,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":26,"operator":"=","quantity":2,"unit":"Gram(s)","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":3,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"neste