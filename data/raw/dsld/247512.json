{"src":"01-raw/2025-09-25/data/label_35.json","id":247512,"nhanesId":"","bundleName":"","fullName":"Animal Pump Pro Strawberry Lemonade Flavor","brandName":"Animal","brandIpSymbol":"®","upcSku":"0 39442 04216 3","productVersionCode":"D2320-G-36695","pdf":"","thumbnail":"","servingsPerContainer":"20","hasOuterCarton":false,"percentDvFootnote":"Not Present","labelRelationships":[{"type":"Flavor difference","labelId":247506}],"contacts":[{"contactId":18566,"text":null,"types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_4.json","id":18566,"name":"Universal Nutrition","streetAddress":"","city":"New Brunswick","state":"New Jersey","country":"USA","zipCode":"08901","phoneNumber":"800-872-0101","email":"","webAddress":"www.animalpak.com"}}],"netContents":[{"order":1,"quantity":15.5,"unit":"Ounce(s)","display":"15.5 Ounce(s)"},{"order":2,"quantity":440,"unit":"Gram(s)","display":"440 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":22,"maxQuantity":22,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"2 scoops","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"Precautions re: Allergies","notes":"Contains: Soy. Made in a GMP facility on equipment that processes milk, soy, egg, peanuts, tree nuts, fish, shellfish, and wheat."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Dosage: Mix two scoops of Animal Pump Pro with 16 oz. of your beverage of choice 15-20 minutes before training."},{"type":"General Statements: All Other Content","notes":"This product is formulated with ingredients that absorb moisture which can lead to clumping of the powder. This is normal and the product is okay to consume."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."},{"type":"General Statements: All Other Content","notes":"Plant US #3001104580"},{"type":"Seals/Symbols","notes":"EAC (Eirasiatic Union)"},{"type":"Precautions re: Children","notes":"Warning: Exercise good judgement and keep this out of reach from children."},{"type":"Storage","notes":"To keep is as fresh as possible, store this product in a cool, dry place, away from heat, moisture and sunlight. You know the drill."},{"type":"Precautions re: All Other","notes":"California Residents: Warning: Reproductive Harm - www.P65Warnings.ca.gov."},{"type":"General Statements: All Other Content","notes":"Our Ironclad Guarantee: Animal is dedicated to being the best in the business, no two ways about it. If this product doesn't meet with your tough requirements for any reason, let us know. When it comes to standing behind our products, we don't mess around. That's the truth."},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General Statements: All Other Content","notes":"...Up the Volume"},{"type":"Formulation re: Other","notes":"Animal Training Powder"},{"type":"Formulation re: Does NOT Contain","notes":"The Non-Stim Pre-Workout Muscle Volumizing Stack"},{"type":"General Statements: All Other Content","notes":"Who We Are\nIn 1983, Animal was founded with the birth of Animal Pak, the venerable training \"pack\" that started it all. Born from the needs and desires of pro bodybuilders, Animal has grown prodigiously over the decades. Today, Animal has stood the test of time and been proven in the trenches day in and day out."},{"type":"Formula re: Type","notes":"What Animal Pump Pro Is\nUp the volume with Animal Pump, the \"core\" non-stim pre-workout product for \"pumps\". For the bodybuilder, getting the pump is the name of the game, what it's all about. It's not just an addictive feeling. Your muscles don't just feel bigger. They are. A pump signals the start of oxygen and nutrient-rich blood flooding into the muscle, setting the table for new growth. So is your table set?"},{"type":"Formula re: Contains","notes":"Nitrosigine\nCitrulline\nHydroMax\nAlpha GPC"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2021-04-22","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":22,"operator":"=","quantity":15,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":2,"ingredientId":283702,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":22,"operator":"=","quantity":4,"unit":"Gram(s)","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":1,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Total Carbohydrates","category":"sugar","ingredientGroup":"Carbohydrate","uniiCode":"0","alternateNames":[],"forms":[]},{"order":3,"ingredientId":292597,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":22,"operator":"=","quantity":170,"unit":"mg","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":7,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Sodium","category":"mineral","ingredientGroup":"Sodium","uniiCode":"9NEZ333N27","alternateNames":["Na"],"forms":[]},{"order":4,"ingredientId":292477,"description":"","notes":"","quantity":[{"servingSizeOrde