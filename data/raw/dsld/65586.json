{"src":"01-raw/2025-09-25/data/label_431.json","id":65586,"nhanesId":"","bundleName":"","fullName":"Ultra Whey Protein Vanilla Ice Cream","brandName":"Universal","brandIpSymbol":"™","upcSku":"0 39442 01638 6","productVersionCode":"B2012-G","pdf":"","thumbnail":"","servingsPerContainer":"15","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":4586,"text":"Formulated, Tested & Manufactured by:","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_2.json","id":4586,"name":"Universal Nutrition","streetAddress":"","city":"New Brunswick","state":"New Jersey","country":"","zipCode":"08901","phoneNumber":"800-872-0101","email":"","webAddress":"www.UniversalUSA.com"}}],"netContents":[{"order":1,"quantity":1,"unit":"lb","display":"1 lb"},{"order":2,"quantity":455,"unit":"Gram(s)","display":"455 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":30,"maxQuantity":60,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1-2 rounded scoops","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"General Statements: All Other Content","notes":"HOW WE BACK IT UP What is on the label is in the bottle and what is in the bottle will help you reach your goals. We guarantee it. Backed by our 100% ironclad money back guarantee, we proudly stand behind every item we produce.If for whatever reason you are not satisfied with any product bearing our name, simply return the remainder to your place of purchase with a receipt for a full refund. Our word is our bond."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Dosage: Mix 1-2 slightly rounded scoops with 6-12 oz. of skim milk or your beverage of choice. On training days take a minimum of 2 servings daily, with 1 serving within 45 minutes after training and the other serving between meals. On non-training days take at least 1 serving daily between meals. For best results, use a blender or a Universal Shaker Cup."},{"type":"Precautions re: Children","notes":"Warning: This product is not for use by anyone under the age of 18."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Do not take this if you have or are at risk for any medical condition or disease. Please consult with a physician before using this product, especially if you are using any prescription drug, over-the-counter medication, or supplements."},{"type":"Precautions re: All Other","notes":"Immediately discontinue use if any side effects occur. For State of California: this product contains a chemical known to the State of California to cause birth defects or other reproductive harm."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."},{"type":"Precautions re: All Other","notes":"Athletes should consult with their sanctioning authority before use. Do not exceed recommended dose."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Precautions re: Allergies","notes":"Made in a GMP facility on equipment that processes milk, soy, egg, peanuts, tree nuts, fish, shellfish, and wheat."},{"type":"General Statements: All Other Content","notes":"Made proudly in the U.S.A."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"2012 Universal Nutrition"},{"type":"FDA Statement of Identity","notes":"Protein Supplement"},{"type":"Formula re: Contains","notes":"Cross-flow ultrafiltered whey peptide protein"},{"type":"General Statements: All Other Content","notes":"Triple whey formula \nMixes easily"},{"type":"General Statements: All Other Content","notes":"WHO WE ARE Universal Nutrition has been providing cu