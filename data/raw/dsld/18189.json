{"src":"01-raw/2025-09-25/data/label_453.json","id":18189,"nhanesId":"","bundleName":"","fullName":"Whey Protein Wild Strawberry","brandName":"Precision Engineered","brandIpSymbol":"®","upcSku":"7 66443 67688 1","productVersionCode":"Prod. # 67688 B66633 03C","pdf":"","thumbnail":"","servingsPerContainer":"47","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[{"type":"Flavor difference","labelId":2483},{"type":"Flavor difference","labelId":67553},{"type":"Flavor difference","labelId":28403},{"type":"Flavor difference","labelId":18190},{"type":"Package size difference, same product","labelId":18114}],"contacts":[{"contactId":1160,"text":"TO REORDER PROD. #67688","types":["Other"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_1.json","id":1160,"name":"","streetAddress":"","city":"","state":"","country":"","zipCode":"","phoneNumber":"1-800-228-4533","email":"","webAddress":"www.vitaminworld.com"}},{"contactId":1162,"text":"Carefully Manufactured by","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_1.json","id":1162,"name":"Precision Engineered Limited (USA)","streetAddress":"","city":"Bohemia","state":"NY","country":"U.S.A.","zipCode":"11716","phoneNumber":"","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":5,"unit":"lb","display":"5 lb"},{"order":2,"quantity":80,"unit":"oz.","display":"80 oz."},{"order":3,"quantity":2268,"unit":"g","display":"2268 g"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":24,"maxQuantity":24,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1 scoop","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Gluten Free"],"productType":{"langualCode":"A1305","langualCodeDescription":"Amino acid/Protein"},"statements":[{"type":"General Statements: All Other Content","notes":"Precision Engineered has pioneered the manufacture of premium sports nutrition supplements. Our commitment to quality is the highest in our industry. Every product undergoes rigorous analysis for purity, potency, safety and freshness. We guarantee it."},{"type":"Seals/Symbols","notes":"QUALITY ASSURED\nQA {check}"},{"type":"Formulation re: Does NOT Contain","notes":"No Preservatives, No Gluten, No Wheat, No Yeast, No Fish."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"WARNING: If you are pregnant, nursing or taking any medications, consult your doctor before use."},{"type":"Precautions re: All Other","notes":"Discontinue use and consult your doctor if any adverse reactions occur."},{"type":"Storage","notes":"Store at room temperature."},{"type":"Precautions re: All Other","notes":"Do not use if seal under cap is broken or missing."},{"type":"General Statements: All Other Content","notes":"Use in conjunction with an intense daily exercise program and a balanced diet including an adequate caloric intake."},{"type":"Formulation re: Does NOT Contain","notes":"No sucrose or fructose added to this product."},{"type":"General Statements: All Other Content","notes":"Not a low calorie product.\nContents are sold by weight. Some settling may occur."},{"type":"FDA Disclaimer Statement","notes":"*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"(C) 2011 Precision Engineered Limited (USA)"},{"type":"General: Product/Version Code","notes":"PROD. # 67688 B66633 03C"},{"type":"General Statements: All Other Content","notes":"HARDCORE SERIES"},{"type":"General Statements: All Other Content","notes":"Whey Protein Powder\nPROTEIN BASED SOURCE OF HIGH QUALITY NUTRITION A GREAT CHOICE FOR ATHLETES OR THOSE ON HIGH PROTEIN DIETS\n• HIGH IN BCAAs • INSTANTIZED FOR EASY MIXING • EASY TO ASSIMILATE\n• 94% LACTOSE FREE"},{"type":"Formulation re: Does NOT Contain","notes":"• ASPARTAME-FREE"},{"type":"FDA Statement of Identity","notes":"DIETARY SUPPLEMENT"},{"type":"General Statements: All Other Content","notes":"NOTICE: Use this product as a food supplement only. Do not use for weight reduction."},{"type":"General Statements: All Other Content","notes":"NATURALLY & ARTIFICIALLY FLAVORED"},{"type":"Suggested/Recommended/Usage/Directions","notes":"DIRECTIONS: For adults, add one (1) scoop (24 g) to 8 fl. ounces of water or your favorite beverage. Mix in your Precision Engineered(R) shaker or a blender and drink immediately for best results. You can drink Precision Engineered(R) Whey Protein any time during the day to add extra high quality protein to your daily calorie intake. Be sure to figure the extra calories provided by milk, juice, yogurt or whatever you may add to your Precision Engineered(R) Whey Protein. Increase or decrease the amount of liquid added to achieve desired consistency."},{"type":"Formula re: Contains","notes":"Contains milk and soy ingredients."},{"type":"General Statements: All Other Content","notes":"HIGH IN PROTEIN\nHIGH CONCENTRATION OF BRANCHED CHAIN AMINO ACIDS\nWhey is popular with bodybuilders, people on high protein diets, and anyone looking for a quick, easy-to-use nutritional drink. Whey is a natural by-product of milk, and is loaded with strength-building protein, which plays a role in optimal nutrition.* Whey naturally contains Branched Chain Amino Acids – made up of Leucine, Isoleucine and Valine. These nutrients are important components of muscle tissue.*"},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Precision Engineered(R) Whey Protein is a high quality, premium whey protein containing a full spectrum glycomacropeptide complex. It is superior nourishment designed for those who want only the best in a nutritional drink. Available in three easy-to-mix flavors, Precision Engineered(R) Whey Protein is the perfect complement to your exercise schedule. For an extra treat, blend with fruit or your favorite non-fat frozen yogurt."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2013-02-25","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":100,"unit":"{Calories}","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":2,"ingredientId":284522,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":20,"unit":"{Calories}","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories from Fat","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]}],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":3,"ingredientId":4822,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":2,"unit":"g","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":3,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":4,"ingredientId":18184,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":24,"operator":"=","quantity":0.5,"unit":"g","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":3,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[