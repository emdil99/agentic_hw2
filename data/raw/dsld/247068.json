{"src":"01-raw/2025-09-25/data/label_236.json","id":247068,"nhanesId":"","bundleName":"","fullName":"Lean Meal Grass-Fed Whey Protein Vanilla","brandName":"Adaptogen Research","brandIpSymbol":"®","upcSku":"0 612524 953504","productVersionCode":"WMV900-PL","pdf":"","thumbnail":"","servingsPerContainer":"25","hasOuterCarton":null,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":22549,"text":"Distributed by","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_4.json","id":22549,"name":"Adaptogen Research","streetAddress":"625 Barksdale Road, Suite 113","city":"Newark","state":"DE","country":"","zipCode":"19711","phoneNumber":"302-213-0030","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":900,"unit":"Gram(s)","display":"900 Gram(s)"},{"order":2,"quantity":2,"unit":"Pound(s)","display":"2 Pound(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":36,"maxQuantity":36,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"Approx. one scoop","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Gluten Free"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"Suggested/Recommended/Usage/Directions","notes":"Recommended Use: As a dietary supplement, mix 36 grams (approx. one scoop) in eight ounces of water or any  other beverage per day, or as directed by your health care practitioner. Lean Meal may be blended into a shake if desired and is not intended to be the sole source of calories, but rather to be used as part of an overall program of healthy eating. Best if consumed within 15 minutes."},{"type":"Formula re: Contains","notes":"Better than Soy\nWhey protein is nature's richest source of biologically active protein. Unlike soy protein, which is low in the amino acid methionine, whey protein contains all the amino acids the body needs in the proper balance."},{"type":"Formulation re: Other","notes":"Notice: This is a natural product that may exhibit color, taste, and density variations from lot to lot. It contains naturally occurring nutrients; therefore amounts may vary within the whey protein and flavor profiles."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"TRAACS and Creatine MagnaPower are registered trademarks of Albion Laboratories, Inc. Creatine MagnaPower is covered by U.S. Patent 6,114,379 and patents pending."},{"type":"Formulation re: Does NOT Contain","notes":"Made with Non-GMO ingredients\nDoes not contain gluten"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General Statements: All Other Content","notes":"Professional Use Only"},{"type":"Precautions re: Allergies","notes":"Contains milk."},{"type":"Formulation re: Other","notes":"Lean Meal: Highest Quality Ingredients and Formulation\nWhen used with a balanced whole foods diet, Lean Meal is designed to help promote an  optimal  intake of protein, fats, carbohydrates, vitamins and minerals needed for overall wellness. Lean Meal is made with a proprietary  native   whey protein concentrate from grass fed dairy cows. This is done so in a way that maintains a full range of the fragile  immune-boosting and regenerative components naturally present in fresh raw milk. It is produced using proprietary filtration and drying which involves minimal processing. This unique production method ensures that the whey is not subjected to temperatures that would destroy key health-promoting compounds. This superior protein comes from    herds that graze year-round on disease-free, pesticide-free, chemical-free, natural grass pastures."},{"type":"Formula re: Contains","notes":"Milk from grass-fed cows has many times higher levels of CLA and contains a proper balance of essential fatty acids.  The milking cows are never fed grain or subjected to any growth hormone treatment, chemicals, antibiotics, genetically modified organisms, hyper-immunization or injected pathogens. The result is the highest quality protein formulation available."},{"type":"Storage","notes":"Store at room temperature."},{"type":"Precautions re: All Other","notes":"Report any adverse reactions to 302-213-0030"},{"type":"Seals/Symbols","notes":"Guaranteed GMP Compliant Products"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2021-04-22","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36,"operator":"=","quantity":110,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":2,"ingredientId":284522,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36,"operator":"=","quantity":15,"unit":"Calorie(s)","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories from Fat","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]}],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":3,"ingredientId":4822,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36,"operator":"=","quantity":1.5,"unit":"Gram(s)","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":2,"footnote":null}],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":4,"ingredientId":18183,"description":"","notes":"","quantity":[{"servingSizeOrder":1,"servingSizeQuanti