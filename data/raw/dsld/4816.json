{"src":"01-raw/2025-09-25/data/label_33.json","id":4816,"nhanesId":"","bundleName":"","fullName":"Amplified 100% Whey Protein Chocolate","brandName":"GNC Pro Performance AMP","brandIpSymbol":"®","upcSku":"","productVersionCode":"Not Present","pdf":"","thumbnail":"","servingsPerContainer":"10","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[{"type":"Package size difference, same product","labelId":4798},{"type":"Package size difference, same product","labelId":4815},{"type":"Flavor difference","labelId":4805}],"contacts":[{"contactId":1337,"text":null,"types":["Other"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_1.json","id":1337,"name":"","streetAddress":"","city":"","state":"","country":"","zipCode":"","phoneNumber":"","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":10,"unit":"Packet(s)","display":"10 Packet(s)"},{"order":2,"quantity":0.08,"unit":"lb","display":"0.08 lb"},{"order":3,"quantity":12.9,"unit":"oz.","display":"12.9 oz."},{"order":4,"quantity":365,"unit":"Gram(s)","display":"365 Gram(s)"}],"physicalState":{"langualCode":"E0172","langualCodeDescription":"Other (e.g. tea bag)"},"servingSizes":[{"order":1,"minQuantity":36.5,"maxQuantity":36.5,"minDailyServings":1,"maxDailyServings":2,"unit":"Gram(s)","notes":"1 packet","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"FDA Statement of Identity","notes":"Dietary supplement"},{"type":"Suggested/Recommended/Usage/Directions","notes":"DIRECTIONS: As a dietary supplement, add one packet (36.5g) of Pro Performance(R) AMP Amplified 100% Whey Protein to 7-8 fl. oz. cold water and blend well. For maximum results, take twice daily."},{"type":"FDA Disclaimer Statement","notes":"*These statements have not been evaluated by the Food and Drug Administration.  This product is not intended to diagnose, treat, cure or prevent any disease."},{"type":"General Statements: All Other Content","notes":"^When used in conjunction with a resistance training program."},{"type":"General Statements: All Other Content","notes":"~ In a randomized, double blind, controlled cross-over study of 16 healthy male volunteers, subjects experienced significantly higher maximum concentrations of Total Amino Acids, Branched Chain Amino Acids and Leucine one hour post-ingestion of two servings of the protein blend in GNC Pro Performance(R) AMP Amplified 100% Whey Protein relative to amino acid concentrations measured post-ingestion of whey protein concentrate. Significant differences for the Rate of Change of BCAA and leucine absorption were also observed relative to the control group."},{"type":"General Statements: All Other Content","notes":"ADVANCED MUSCLE PERFORMANCE"},{"type":"General Statements: All Other Content","notes":"CHOCOLATE\nNatural + artificial flavors"},{"type":"General Statements: All Other Content","notes":"Daily Power Strength Recovery"},{"type":"General Statements: All Other Content","notes":"Micronized protein + amino acids"},{"type":"General Statements: All Other Content","notes":"The Amplified 100% Whey Protein Evolution\nWhat makes this protein AMPlified? Using cutting-edge technology and top notch research and development principles, this protein was designed to be the new champion of the whey protein category."},{"type":"General Statements: All Other Content","notes":"Why is Amplified 100% Whey Protein Better than Regular Whey?\nThink ordinary whey protein is good enough? Think again. Amplified 100% Whey Protein features technology-enhanced protein with hydrolysates clinically proven to deliver more amino acids into the blood stream – better and faster than regular whey!~ The result…more amino acids are available for muscle fuel! These critical amino acids support athletic strength, performance, endurance and recovery.*"},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"BioCore Edge(TM) is a trademark of National Enzyme Company."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Sunfiber(R) is a registered trademark of Taiyo International, Inc. Use of Sunfiber(R) is protected by US Trademark Registration No. 2,930,937."},{"type":"Precautions re: Allergies","notes":"CONTAINS: Milk, Soybeans and Wheat."},{"type":"Seals/Symbols","notes":"Clinically Researched"},{"type":"Precautions re: All Other","notes":"NOTICE: Use this product as a food supplement only. Do not use for weight reduction. Significant product settling may occur."}],"claims":[{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2012-01-25","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"ingredientRows":[{"order":1,"ingredientId":284519,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36.5,"operator":"=","quantity":130,"unit":"{Calories}","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[{"order":2,"ingredientId":284522,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36.5,"operator":"=","quantity":20,"unit":"{Calories}","dailyValueTargetGroup":[],"servingSizeUnit":"Gram(s)"}],"nestedRows":[],"name":"Calories from Fat","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]}],"name":"Calories","category":"other","ingredientGroup":"Calories","uniiCode":"1","alternateNames":[],"forms":[]},{"order":3,"ingredientId":18586,"description":null,"notes":null,"quantity":[{"servingSizeOrder":1,"servingSizeQuantity":36.5,"operator":"=","quantity":2,"unit":"g","dailyValueTargetGroup":[{"name":"Adults and children 4 or more years of age","operator":"=","percent":3,"fo