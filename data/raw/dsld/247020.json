{"src":"01-raw/2025-09-25/data/label_188.json","id":247020,"nhanesId":"","bundleName":"","fullName":"Grass-Fed Whey Protein Vanilla","brandName":"Adaptogen Research","brandIpSymbol":"®","upcSku":"0 612524 953528","productVersionCode":"WCV900-PL-4","pdf":"","thumbnail":"","servingsPerContainer":"30","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":22549,"text":"Distributed by","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_4.json","id":22549,"name":"Adaptogen Research","streetAddress":"625 Barksdale Road, Suite 113","city":"Newark","state":"DE","country":"","zipCode":"19711","phoneNumber":"302-213-0030","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":900,"unit":"Gram(s)","display":"900 Gram(s)"},{"order":2,"quantity":2,"unit":"Pound(s)","display":"2 Pound(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":30,"maxQuantity":30,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1 Scoop","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Gluten Free"],"productType":{"langualCode":"A1305","langualCodeDescription":"Amino acid/Protein"},"statements":[{"type":"General Statements: All Other Content","notes":"Typical Amino Acid Profile\nGrams/ 30 gram serving\nAlanine 1.3\nArginine 0.6\nAspartic acid 2.7\nCysteine 0.5\nGlutamic Acid 4.5\nGlycine 0.5\nHistidine 0.5\nisoleucine 1.6\nLeucine 2.7\nLysine 2.4\nMethionine 0.5\nPhenylalanine 0.8\nProline 1.5\nSerine 1.3\nThreonine 1.8\nTryptophan 0.5\nTyrosine 0.8\nValine 1.5\n"},{"type":"Formulation re: Does NOT Contain","notes":"Does not Contain Gluten\nMade with Non-GMO ingredients"},{"type":"Formulation re: Other","notes":"Notice: This is a natural product that may exhibit color, taste, and density variations from lot to lot. It contains naturally occurring nutrients, therefore amounts may vary within the whey protein and flavor profiles."},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General Statements: All Other Content","notes":"Professional Use Only"},{"type":"Precautions re: Allergies","notes":"Contains milk."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Recommended Use: As a dietary supplement, mix 30 grams (approx. one scoop) in eight ounces of water or any other beverage per day, or as directed by your health care practitioner"},{"type":"Formula re: Contains","notes":"Grass-Fed Whey Protein, is made with a proprietary native whey protein concentrate from grass fed dairy cows. This is done so in a way that maintains a full range of the fragile immune-boosting and regenerative components naturally present in fresh raw milk."},{"type":"Formulation re: Other","notes":"It is produced using proprietary filtration and drying which involves minimal  processing.  This unique production method ensures that the whey is not subjected to temperatures that would destroy key health-promoting compounds. This superior protein comes from herds  that graze year-round on disease-free, pesticide-free, chemical-free, natural grass pastures. Milk from grass-fed cows has many times higher levels of CLA and contains a proper balance of essential fatty acids. The milking cows are never fed grain or subjected to any growth hormone treatment, chemicals, antibiotics, genetically modified organisms, hyper-immunization or injected pathogens. The result is the highest quality protein formulation available."},{"type":"Storage","notes":"Store at room temperature."},{"type":"Formulation re: Other","notes":"Manufactured in a GMP Registered Facility in the USA."},{"type":"General Statements: All Other Content","notes":"Report any adverse reactions to 302-213-0030"},{"type":"Seals/Symbols","notes":"Guaranteed GMP Compliant Products"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualC