{"src":"01-raw/2025-03-25/data/label_140.json","id":323724,"nhanesId":"","bundleName":"","fullName":"Hyde Nightmare Jawbreaker","brandName":"PS ProSupps","brandIpSymbol":"®","upcSku":"8 10034 81262 9","productVersionCode":"L81262-01","pdf":"323724_document.pdf","thumbnail":"323724_thumbnail.jpg","servingsPerContainer":"30","hasOuterCarton":null,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[{"type":"Flavor difference","labelId":323179},{"type":"Flavor difference","labelId":323725}],"contacts":[{"contactId":25801,"text":"Manufactured for and Distributed by","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_5.json","id":25801,"name":"ProSupps USA, LLC.","streetAddress":"5757 Main Street Suite 205","city":"Frisco","state":"TX","country":"","zipCode":"75034","phoneNumber":"1-866-575-7301","email":"Quality@ProSupps.com","webAddress":""}}],"netContents":[{"order":1,"quantity":11,"unit":"Ounce(s)","display":"11 Ounce(s)"},{"order":2,"quantity":312,"unit":"Gram(s)","display":"312 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":5.2,"maxQuantity":10.4,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1 Scoop (10.4g)","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Women (not pregnant or lactating)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"General Statements: All Other Content","notes":"Your competition's worst nightmare"},{"type":"Formulation re: Other","notes":"Hyde Nightmare was formulated for high-performance athletes who endure an excessive amount of physical and mental stress. Driven by clinically researched ingredients to improve muscular and mental performance, as well as replenishing lost fluids during rigorous activity."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Suggested use: To assess tolerance, mix 1/2 scoop of Hyde Nightmare with 4oz of cold water. Once tolerance has been assessed, mix 1 scoop of Hyde Nightmare with 6-8oz of cold water and consume 15-30 minutes prior to intense training or competition."},{"type":"Precautions re: All Other","notes":"Do not consume Hyde Nightmare within 4 hours of bedtime. Do not take any other products that contain caffeine or stimulants while taking Hyde Nightmare.\r\nConsult a physician prior to using this, or any other dietary supplement.\r\nDo not exceed recommended serving. Exceeding recommended serving may cause adverse health effects.\r\nToo much caffeine may cause nervousness, irritability, sleeplessness. and occasional rapid heartbeat. Immediately discontinue use and consult a qualified medical professional if you experince any adverse effects."},{"type":"Precautions re: Children","notes":"Warning: This product is intended for healthy adults, 18 years of age or older.\r\nKeep out of reach of children."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Do not take this product if you are pregnant or nursing, if you have or suspect you may have a medical condition, or if you are taking any prescription or over-the-counter medications. "},{"type":"Precautions re: All Other","notes":"This product contains 300mg of caffeine, the equivalent of approximately 3 cups of coffee and may not be suitable for individuals who are sensitive to the effects of caffeine."},{"type":"Precautions re: All Other","notes":"Warning for California Residents: Consuming this product can expose you to lead which is known to the State of California to cause cancer and birth defects or other reproductive harm. For more information go to: www.P65Warnings.ca.gov"},{"type":"Storage","notes":"Store in a cool, dry place. Content sold by weight not volume, some settling may occur. Protect from heat, light and moisture."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and 