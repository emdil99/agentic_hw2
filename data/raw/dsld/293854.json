{"src":"01-raw/2025-09-25/data/label_222.json","id":293854,"nhanesId":"","bundleName":"","fullName":"Keto Electrolyte Tablets","brandName":"Trace Minerals","brandIpSymbol":"®","upcSku":"8 78941 00448 3","productVersionCode":"r-M3Y20","pdf":"293854_document.pdf","thumbnail":"293854_thumbnail.jpg","servingsPerContainer":"15","hasOuterCarton":null,"percentDvFootnote":"Percent Daily Values (DV) are based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":25649,"text":null,"types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_5.json","id":25649,"name":"Trace Minerals","streetAddress":"P.O. Box 429","city":"Roy","state":"UT","country":"USA","zipCode":"84067","phoneNumber":"(801) 731-6051","email":"","webAddress":"www.traceminerals.com"}}],"netContents":[{"order":1,"quantity":90,"unit":"Tablet(s)","display":"90 Tablet(s)"}],"physicalState":{"langualCode":"E0155","langualCodeDescription":"Tablet or Pill"},"servingSizes":[{"order":1,"minQuantity":4,"maxQuantity":6,"minDailyServings":1,"maxDailyServings":1,"unit":"Tablet(s)","notes":"","inSFB":true}],"targetGroups":["Vegan","Vegetarian","Adult (18 - 50 Years)","Gluten Free","Dairy Free"],"productType":{"langualCode":"A1317","langualCodeDescription":"Botanical with Nutrients"},"statements":[{"type":"Formulation re: Other","notes":"Helps avoid electrolyte imbalance, muscle cramps, and dehydration, also known as the \"keto flu\""},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"Formula re: Contains","notes":"Keto Electrolytes is a potent electrolyte formula that is ideal for anyone on the Keto Diet. It provides full spectrum electrolytes your body may be lacking to help avoid electrolyte imbalance, dehydration, leg or other muscle cramps, which are part of what is termed as the \"keto flu.\" Keto Electrolyte Tablets also contain vitamin B6 (P-5-P) and taurine to help get magnesium into the cells more effectively to help maintain muscle stamina, support ATP production, and promote cardiovascular health."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Suggested use: 4-6 tablets daily, divided with meals. Take especially before and after periods of physical activity. Take with large amounts of fluid. We recommend also using our Keto Electrolyte Drops & Keto Electrolyte Powder."},{"type":"Precautions re: Allergies","notes":"No known allergens."},{"type":"Formulation re: Does NOT Contain","notes":"Gluten free.\r\n"},{"type":"Formula re: Contains","notes":"Plus a concentrated complex of full spectrum ionic trace minerals."},{"type":"General Statements: All Other Content","notes":"Feel the difference guarantee\r\nAmerica's 1 Trace Mineral Brand\r\nRecycle\r\nBPA free"},{"type":"Formula re: Type","notes":"Keto"},{"type":"Formulation re: Vegetarian/Vegan","notes":"Certified Vegan"},{"type":"Formulation re: Does NOT Contain","notes":"Gluten free"},{"type":"Seals/Symbols","notes":"cGMP certified\r\n3rd Party Tested"},{"type":"General Statements: All Other Content","notes":"Join us on social media!\r\nGiveaways, recipes, health tips & more!"},{"type":"Precautions re: Children","notes":"Warning: Accidental overdose of iron-containing products is a leading cause of fatal poisoning in children under 6. Keep this product out of reach of children. In case of accidental overdose, call of doctor or poison control center immediately.\r\n"},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2023-07-18","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCo