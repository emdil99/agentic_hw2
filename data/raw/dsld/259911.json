{"src":"01-raw/2025-09-25/data/label_113.json","id":259911,"nhanesId":"","bundleName":"","fullName":"Concentrate Whey Protein Chocolate","brandName":"Muscle Feast","brandIpSymbol":"®","upcSku":"","productVersionCode":"Not Present","pdf":"259911_document.pdf","thumbnail":"259911_thumbnail.jpg","servingsPerContainer":"37","hasOuterCarton":false,"percentDvFootnote":"The % Daily Value tells you how much a nutrient in a serving of food contributes to a daily diet. 2,000 calories a day is used for general nutrition advice.","labelRelationships":[{"type":"Package size difference, same product","labelId":262521},{"type":"Image difference, same product","labelId":214544},{"type":"Package size difference, same product","labelId":214544}],"contacts":[{"contactId":18813,"text":"Manufactured by","types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_4.json","id":18813,"name":"Muscle Feast","streetAddress":"1320 Boston Road","city":"Nashport","state":"OH","country":"","zipCode":"43830","phoneNumber":"(888) 734-3634","email":"","webAddress":"www.musclefeast.com"}}],"netContents":[{"order":1,"quantity":2,"unit":"Pound(s)","display":"2 Pound(s)"},{"order":2,"quantity":909,"unit":"Gram(s)","display":"909 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":24,"maxQuantity":24,"minDailyServings":1,"maxDailyServings":null,"unit":"Gram(s)","notes":"1 Level Scoop","inSFB":true}],"targetGroups":["Vegetarian","Adult (18 - 50 Years)","Kosher","Women (not pregnant or lactating)","Gluten Free"],"productType":{"langualCode":"A1305","langualCodeDescription":"Amino acid/Protein"},"statements":[{"type":"Formula re: Contains","notes":"Muscle Feast Grass Fed Hormone Free Whey Protein Concentrate is designed to be a great source for quality and cost-effective whey protein. Concentrated whey protein provides high amounts of immunoglobulin g (IgG) and L-cystine; both of which have been proven to significantly improve health. Sourced from cows that are certified to be grass fed and free of added hormones, you can rest assured that you're receiving the absolute best in whey protein. Our whey protein is undenatured, cold microfiltered, and ultrafiltration processed."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Suggested use: Mix one serving (1 level scoop) thoroughly into 6-10 ounces of water or beverage of your choice. We do not believe in using fillers in our protein powders; we suggest using milk or milk substitute for better taste.\nMix 1 level (24 g) scoop thoroughly with 6-10 oz. or more water (or beverage of choice)."},{"type":"Formulation re: Other","notes":"All natural / grass fed"},{"type":"Formulation re: Does NOT Contain","notes":"Gluten free / soy free / no GMOs / hormone free / antibiotic free"},{"type":"Formulation re: Other","notes":"Labadoor tested for accuracy\nLabadoor tested for purity\nLabadoor tested for sport"},{"type":"Storage","notes":"Keep tightly closed in a cool, dry place away from sunlight."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."},{"type":"FDA Disclaimer Statement","notes":"This statement has not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Precautions re: All Other","notes":"Do not exceed the recommended dose. Consult your physician before using this product."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Do not use this product if you are pregnant or nursing. Do not use this product if you are taking any prescription medication."},{"type":"Precautions re: Children","notes":"Do not use this product if you are under the age of 18."},{"type":"Seals/Symbols","notes":"OU D (Kosher Dairy)\nMade in an FDA Registered Facility\nGMP Good Manufacturing Practice\nCertified Vegetarian AVA\nAmerican Vegetarian Association"},{"type":"Formula re: Kosher","notes":"OU D