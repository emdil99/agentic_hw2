{"src":"01-raw/2025-09-25/data/label_150.json","id":218433,"nhanesId":"","bundleName":"","fullName":"Essential AmiN.O. Energy + Electrolytes Pineapple Twist","brandName":"ON Optimum Nutrition","brandIpSymbol":"®","upcSku":"7 48927 06051 5","productVersionCode":"V.1.051.0418US 6047300","pdf":"","thumbnail":"","servingsPerContainer":"30","hasOuterCarton":null,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[],"contacts":[{"contactId":19035,"text":"Manufactured by","types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_4.json","id":19035,"name":"Optimum Nutrition, Inc.","streetAddress":"3500 Lacey Road, Suite 1200","city":"Downers Grove","state":"IL","country":"","zipCode":"60515","phoneNumber":"1 (800) 705-5226","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":10.05,"unit":"Ounce(s)","display":"10.05 Ounce(s)"},{"order":2,"quantity":285,"unit":"Gram(s)","display":"285 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":9.5,"maxQuantity":9.5,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"2 Scoops","inSFB":true}],"targetGroups":["Adult (18 - 50 Years)","Women (not pregnant or lactating)"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"Formula re: Contains","notes":"Essential Amin.O. Energy Plus Electrolytes offers a combination of 5 grams of amino acids, 100 milligrams of caffeine, and electrolytes to support performance, endurance and active living.\nIngredient Amount Support\nAmino acids 5 g muscle recovery\nCaffeine 100 mg energy + focus\nElectrolytes sodium 110 mg potassium 50 mg magnesium 60 mg chloride 200 mg hydration and performance\nDial-up your energy & aminos\nTwo scoops = one serving\nScoop #\nEnergy level mild moderate intense\nAmino level 5 grams 10 grams 15 grams\nCaffeine 100 mg 200 mg 300 mg"},{"type":"Formulation re: Other","notes":"Occasion\nAnytime you need any energy boost\nPre-workout energy & hydration\nPost workout recovery & rehydration\nWhen added to at least 10 fl oz of water"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Recommended Use for Healthy Adults:\nFor pre-workout energy and hydration support: Take 2-6 scoops with at least 10-12 fl oz of water 30 min before training.\nFor post-workout muscle recovery support: Take 2-4 scoops with at least 10-12 fl oz of water after training."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: Consult your physician before using this product if you are taking any medications or are under a physician's care for a medical condition. Not for use by those under the age of 18, women that are pregnant, trying to get pregnant, or nursing, or those that are sensitive to caffeine or beta-alanine."},{"type":"Precautions re: Children","notes":"Not for use by those under the age of 18, women that are pregnant, trying to get pregnant, or nursing, or those what are sensitive to caffeine or beta-alanine."},{"type":"Precautions re: All Other","notes":"Do not consume caffeine from other sources while taking this product as too much caffeine may cause nervousness, irritability, sleeplessness, and occasionally rapid heartbeat. Beta-alanine may cause a harmless, temporary tingling or flushing sensation. \nDo not combine with alcohol. Do not exceed 6 scoops within any 4 hour period or 10 scoops within any 24 hour period. Consume as part of a healthy diet and exercise program, and drink at least 100 fl oz of water per day. Exercise may increase your need for fluid intake."},{"type":"Seals/Symbols","notes":"Manufactured in the USA\nThis product contains ingredients of international and domestic origin\n"},{"type":"Formula re: Contains","notes":"Plus electrolytes\nPineapple twist\nNaturally and artificially flavored"},{"type":"Formulation re: Other","notes":"Use anytime to support:\nHydration\nFocus & energy\nMuscle recovery"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"Seals/Symbols","notes":"Banned substance tested"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: Mix two scoops in 10-12 fl oz of cold water.\n"},{"type":"Precautions re: Allergies","notes":"Contains: Soy."},{"type":"Formula re: Contains","notes":"Caffeine from natural source"},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"CarnoSyn\nCarnosine synthesizer\nNatural Alternatives International (NAI) is the owner of patents as listed on www.carnosyn.com and registered trademark CarnoSyn"},{"type":"Storage","notes":"Store in a cool, dry place away from direct sunlight.\n"},{"type":"Seals/Symbols","notes":"Informed-Choice.org\nTrusted by sport"},{"type":"General Statements: All Other Content","notes":"Informed-Choice is a quality assurance program for sports nutrition products. The program certifies that nutritional supplements that bear the Informed-Choice logo have been tested for banned substances by the world class sports anti-doping lab, LGC Limited.\n"},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.\n"},{"type":"Storage","notes":"To maximize freshness and minimize product clumping, store tightly-closed container in a cool, dry place.\n"},{"type":"General Statements: All Other Content","notes":"Contents sold by weight not volume.\n"}],"claims":[{"langualCode":"P0065","langualCodeDescription":"Nutrient "},{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Structure/Function"}],"events":[{"date":"2020-04-23","type":"Date entered into DSLD"}],"userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and ab