{"src":"01-raw/2025-09-25/data/label_334.json","id":53108,"nhanesId":"","bundleName":"","fullName":"PGX SATISFAST Whey Protein Dark Chocolate","brandName":"Natural Factors","brandIpSymbol":"®","upcSku":"0 68958 03575 8","productVersionCode":"R2","pdf":"","thumbnail":"","servingsPerContainer":"14","hasOuterCarton":false,"percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","labelRelationships":[{"type":"Flavor difference","labelId":9334},{"type":"Image difference, same product","labelId":9334},{"type":"Package size difference, same product","labelId":38684},{"type":"Package size difference, same product","labelId":53177},{"type":"Flavor difference","labelId":53111}],"contacts":[{"contactId":2592,"text":"Manufactured by","types":["Manufacturer"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_1.json","id":2592,"name":"Natural Factors Canada","streetAddress":"","city":"","state":"","country":"","zipCode":"","phoneNumber":"","email":"","webAddress":""}},{"contactId":7318,"text":"Distributed by","types":["Distributor"],"contactDetails":{"src":"01-raw/2025-09-25/data/contact_2.json","id":7318,"name":"Natural Factors","streetAddress":"14224 167th Avenue SE","city":"Monroe","state":"WA","country":"","zipCode":"98272","phoneNumber":"","email":"","webAddress":""}}],"netContents":[{"order":1,"quantity":8.9,"unit":"oz.","display":"8.9 oz."},{"order":2,"quantity":252,"unit":"Gram(s)","display":"252 Gram(s)"}],"physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"servingSizes":[{"order":1,"minQuantity":18,"maxQuantity":18,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1 scoop","inSFB":true}],"targetGroups":["Vegetarian","Adult (18 - 50 Years)","Gluten Free","Sugar Free"],"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"statements":[{"type":"General Statements: All Other Content","notes":"2 g Available Carbs (Total Carbs - Fiber = Available Carbs)"},{"type":"General Statements: All Other Content","notes":"~  Helps reduce appetite before your next meal*\n~  Makes a healthy and convenient snack option"},{"type":"Formula re: Contains","notes":"~ Highly efficient, undenatured, microfiltered and ultrafiltered whey from grass-fed cows – free of rBGH, BSE, and GMOs"},{"type":"Formulation re: Does NOT Contain","notes":"~ Highly efficient, undenatured, microfiltered and ultrafiltered whey from grass-fed cows – free of rBGH, BSE, and GMOs"},{"type":"Formula re: Contains","notes":"Contains glutamic acid and branched-chain amino acids (BCAA)"},{"type":"General Statements: All Other Content","notes":"Also available in Very Vanilla"},{"type":"General Statements: All Other Content","notes":"when combined with a healthy diet and regular exercise."},{"type":"General Statements: All Other Content","notes":"Notice: A small percentage of people may initially experience minor digestive changes when \ntaking PGX."},{"type":"Suggested/Recommended/Usage/Directions","notes":"Slowly work up to the full dose to give your body time to adjust. It is important to drink adequate amounts of water (8–16 oz. or 1-2 cups) after taking PGX."},{"type":"Precautions re: Children","notes":"Cautions: Consult your health professional before use if you are under 18 years of age or have \nany health concerns."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"If you are taking medication, take it one hour prior to or two hours after taking PGX. As with any supplement, consult your health professional before use if you are pregnant, breastfeeding or trying to conceive, or if you have a medical condition or anticipate a surgery."},{"type":"Precautions re: Children","notes":"Keep out of the reach of children."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Try other PGX products including PGX Daily Ultra Matrix Softgels and SlimStyles PGX Ultra \nMatrix Plus Soothe Digest. Also try a SlimStyles Meal Replacement Weight Loss drink – a \nblend of PGX and high quality whey protein with added nutrients that makes a creamy, \ndelicious smoothie! \n"},{"type":"General Statements: All Other Content","notes":"Available in 4 flavors: Double Chocolate, French Vanilla, Very Strawberry, and Rich Mocha."},{"type":"FDA Disclaimer Statement","notes":"This statement has not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."},{"type":"General Statements: All Other Content","notes":"Feel Full For Hours"},{"type":"Seals/Symbols","notes":"isura"},{"type":"Formulation re: Does NOT Contain","notes":"NON-GMO"},{"type":"General Statements: All Other Content","notes":"MASS SPEC\nDocumentation\nLab Tested"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Suggested usage: Add 1 scoop (18 g) to 5 oz. (150 ml) of cold water and shake in a shaker \ncup. Take PGX SATISFAST with or without food or as directed by a health professional. Drink \nan additional glass of water (8–16 oz. or 1–2 cups) after taking PGX SATISFAST."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Get energized and satisfy your cravings between meals or at snack time with PGX  SATISFAST. Drinking PGX SATISFAST will help reduce your hunger so you will be satisfied with smaller portions, and may give you the willpower to pass up high-calorie, low-nutrient foods.* Taking PGX SATISFAST at breakfast will help increase your protein consumption without adding a lot of extra calories."},{"type":"General Statements: All Other Content","notes":"Reduces appetite by promoting a feeling of fullness.* Helps lower the glycemic index.* Helps \nmaintain healthy blood sugar and total cholesterol levels already within the normal range."},{"type":"Formula re: Contains","notes":"Combines the weight loss benefits of PGX with high quality whey protein*\n~ Contains 2.5 g PGX per serving\n~ Provides soluble fiber, 10 grams of protein, and only 60 calories per serving\n"},{"type":"Formulation re: Does NOT Contain","notes":"No sugar added – gluten free"},{"type":"General Statements: All Other Content","notes":"- tastes delicious!"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"Formula re: Contains","notes":"100% Natural Whey Protein\n60 Calories per serving"},{"type":"General Statements: All Other Content","notes":"Grass-Fed"},{"type":"Formulation re: Does NOT Contain","notes":"~ Gluten Free ~ No Trans Fats"},{"type":"Formula re: Contains","notes":"10 g Protein per serving"},{"type":"Formula re: Contains","notes":"Contains milk and soy."},{"type":"Precautions re: Allergies","notes":"Contains milk and soy."},{"type":"FDA Disclaimer Statement","notes":"Manufactured by Natural Factors to ensure safety and potency in accordance with Good \nManufacturing Practices (GMP) of the FDA and Health Canada."},{"type":"Formulation re: Does NOT Contain","notes":"Contains no artificial colors, preservatives, or sweeteners;no starch, sugar, wheat, gluten, \nyeast, egg, fish, shellfish, tree nuts, or GMOs."},{"type":"Formulation re: Vegetarian/Vegan","notes":"Suitable for vegetarians."},{"type":"Precautions re: All Other","notes":"Sealed for your protection. Do not use if seal is broken."},{"type":"Storage","notes":"For freshness, store in a cool, dry place."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"PGX, PolyGlycopleX, SATISFAST and EnviroSimplex are registered trademarks of InovoBiologic Inc.\nPGX US Patents 8062686; 8597709."},{"type":"General Statements: All Other Content","notes":"Product of Canada"},{"type":"Seals/Symbols","notes":"Purity&Potency Guaranteed"},{"type":"General Statements: All Other Content","notes":"Recyclable container and label."},{"type":"General: Product/Version Code","notes":"R2"},{"type":"General Statements: All Other Content","notes":"(18 g x 14 servings)"}],"claims":[{"langualCode":"P0115","langualCodeDescription":"All Other"},{"langualCode":"P0265","langualCodeDescription":"Str